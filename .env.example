# ==========================================
# 🚗 Kashif AI - Environment Variables
# ==========================================

# 1. Google Gemini API Key (Get your key from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. Default Gemini Model (defaults to gemini-3.7-flash)
# Supported options: gemini-3.7-flash | gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash
GEMINI_MODEL=gemini-3.7-flash

# 3. App Settings
NEXT_PUBLIC_APP_NAME="Kashif AI - كاشف الذكي"
