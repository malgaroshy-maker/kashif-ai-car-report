# ==========================================
# 🚗 Kashif AI - Environment Variables
# ==========================================

# 1. Google Gemini API Key (Get your key from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. Default Gemini Model (defaults to gemini-3.8-flash)
# Supported options: gemini-3.8-flash | gemini-3.7-flash | gemini-3.6-flash | gemini-3.5-flash
GEMINI_MODEL=gemini-3.8-flash

# 3. App Settings
NEXT_PUBLIC_APP_NAME="Kashif AI - كاشف الذكي"

# 4. eBay Browse API (optional) — part photos looked up by OEM number
#
# Without these two, the app behaves exactly as before: photos come from the
# curated registry and Wikimedia, searched by the part's name. With them, a
# part that has an OEM number is also looked up in eBay's catalogue, and a
# listing whose title quotes that number supplies its photograph — shown as a
# listing, linked to it, and never embedded in the exported offline file.
#
# Create a Production keyset at https://developer.ebay.com/my/keys
# (Application access / client credentials; no user consent needed).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# 5. Aftermarket catalogue (optional) — the strongest part-photo source
#
# Looked up by OEM number rather than searched by name, so the match cannot be
# wrong. Returns the aftermarket equivalent of the genuine part; the card says
# so and names the brand. Measured at 10 photographs over 16 real Libyan part
# numbers, including several nothing else could answer.
#
# Free plan is 100 requests/month and each lookup costs two, so an unpaid key
# covers about fifty parts. Every failure falls through to the next source.
# Key and base URL: Console -> Developer Settings at
# https://auto-parts-catalog.apiprofile.com
AUTOPARTS_API_KEY=
AUTOPARTS_BASE_URL=
